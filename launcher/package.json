{
  "name": "codex-web-gpt-launcher",
  "version": "6.1.13",
  "private": true,
  "description": "Local privacy-hardened source build of Codex ChatGPT Web; no upstream updates or local usage telemetry.",
  "author": "miuuyy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.cjs",
    "audit": "bun audit",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "bun run typecheck && bun run build:renderer",
    "build:runtime": "bun run scripts/prepare-runtime.cjs",
    "package": "bun run build && bun run build:runtime && bun run scripts/package.cjs",
    "package:mac": "bun run build && bun run build:runtime && bun run scripts/package.cjs --mac",
    "package:win": "bun run build && bun run build:runtime && bun run scripts/package.cjs --win",
    "package:linux": "bun run build && bun run build:runtime && bun run scripts/package.cjs --linux",
    "smoke:package": "bun run scripts/smoke-package.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "42.11.16",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.9",
    "undici": "7.30.1",
    "node-gyp/undici": "6.29.1",
    "global-agent": "4.1.3",
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2"
  },
  "build": {
    "appId": "dev.codexwebgpt.privacy",
    "productName": "Codex Web GPT Private",
    "artifactName": "codex-web-gpt-private-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/linux-appimage-runner.sh"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/update.cjs",
      "!electron/update-worker.cjs",
      "!electron/limits-controller.cjs",
      "!electron/limits-store.cjs",
      "assets/icon.png",
      "assets/trayTemplate*.png",
      "assets/linux-appimage-runner.sh",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signIgnore": [
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]runtime[/\\\\]bun$"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "guid": "08369f9a-da81-531c-87fa-5a40250dd4e6",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
